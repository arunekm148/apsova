# Hostinger VPS Environment Configuration

# Application Server
PORT=3000
NODE_ENV=production

# Database (PostgreSQL installed on Hostinger VPS)
DATABASE_URL="postgresql://apsova_user:YOUR_STRONG_PASSWORD@localhost:5432/apsova_db?schema=public"

# Authentication (NextAuth / JWT Secret)
NEXTAUTH_URL="https://yourdomain.com"
NEXTAUTH_SECRET="CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY"

# Cron Secret (for securing /api/cron/renewals and /api/cron/escalations)
CRON_SECRET_TOKEN="CHANGE_THIS_TO_A_SECURE_TOKEN"

# WhatsApp Automation API (Meta Cloud API / Gupshup / Interakt)
WHATSAPP_API_URL="https://graph.facebook.com/v20.0/YOUR_PHONE_NUMBER_ID/messages"
WHATSAPP_ACCESS_TOKEN=""

# Meta Lead Ads Webhook Secret
META_WEBHOOK_VERIFY_TOKEN=""

# Local File Upload Directory on Hostinger VPS
UPLOAD_DIR="/var/www/apsova/uploads"
